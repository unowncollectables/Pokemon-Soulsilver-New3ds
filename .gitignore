# .gitignore

# ROMs, saves, extracted game data, and local dumps
*.nds
*.sav
*.pak
*.rom
*.bin
*.dump
roms/
rom/
data_pack/
extracted/
extract/

# Build outputs
build/
out/
dist/
obj/
*.3dsx
*.cia
*.smdh
*.bnr
*.elf
*.app

# Editor and OS junk
.DS_Store
Thumbs.db
*.swp
*.swo
*.tmp
*~

# Local toolcache or generated artifacts
.vscode/
.idea/
.cache/
coverage/

# pspoke work tree and its downloads (scripts/bootstrap.sh); everything in them is built from the decomp + your ROM
pspoke/
.work/
upstream/
baserom/
# Objects, archives and logs from the 3DS build
*.o
*.a
*.d
*.map
*.shbin
*.narc
*.sdat
*.dsv
log.txt
*.log
followers.bin
__pycache__/
*.pyc
