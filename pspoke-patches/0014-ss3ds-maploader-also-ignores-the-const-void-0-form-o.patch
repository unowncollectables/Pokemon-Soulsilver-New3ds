From 87332e8384fcd70f4e95885a1d71ceab8d3be299 Mon Sep 17 00:00:00 2001
From: ss3ds <ss3ds@localhost>
Date: Sun, 25 Oct 2026 00:23:22 +0000
Subject: [PATCH] ss3ds: maploader also ignores the const void[0] form of that
 warning

---
 port/soulsilver-native-play/maploader/port.py | 4 ++--
 1 file changed, 2 insertions(+), 2 deletions(-)

diff --git a/port/soulsilver-native-play/maploader/port.py b/port/soulsilver-native-play/maploader/port.py
index 250b606..cb7f7d2 100644
--- a/port/soulsilver-native-play/maploader/port.py
+++ b/port/soulsilver-native-play/maploader/port.py
@@ -402,8 +402,8 @@ if '--compile' in sys.argv:
     # was missed. GCC also emits -Warray-bounds for the assert path where a pointer is
     # provably NULL ('out of the bounds [0, 0]'): that mirrors the original's behaviour
     # and is not a frame problem, so it is ignored.
-    # ss3ds: newer GCC (devkitARM) words the same NULL case as "outside array bounds of 'void[0]'".
-    real = [l for l in r.stderr.splitlines() if 'bounds=' in l and '[0, 0]' not in l and "of 'void[0]'" not in l]
+    # ss3ds: newer GCC (devkitARM) words the same NULL case as "outside array bounds of '(const) void[0]'".
+    real = [l for l in r.stderr.splitlines() if 'bounds=' in l and '[0, 0]' not in l and "void[0]'" not in l]
     if real:
         sys.stderr.write('\n'.join(real) + '\n')
         raise SystemExit('frame bounds warning: an incoming stack argument was missed')
-- 
