   "G2x_SetBlendBrightnessExt_": "SSAsm_G2x_SetBlendBrightnessExt_",
   "G2x_ChangeBlendBrightness_": "SSAsm_G2x_ChangeBlendBrightness_",
-  "ov07_0221FDFC": "SS3DS_BattleMonOBJ_NewAll"
+  "ov07_0221FDFC": "SS3DS_BattleMonOBJ_NewAll",
+  "sub_0205DE88": "SS3DS_RunHeld"
  }
 }
