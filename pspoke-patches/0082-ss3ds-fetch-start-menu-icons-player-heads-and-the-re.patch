From 7c4119ba312ce93680fe94ec3de1dafd9d2d9b82 Mon Sep 17 00:00:00 2001
From: ss3ds <ss3ds@local>
Date: Sun, 25 Oct 2026 23:56:35 -0400
Subject: [PATCH] ss3ds: fetch start-menu icons, player heads and the
 registered item's icon from the ROM for the bottom layout (hook 0081)

---
 scripts/ss3ds_hooks.d/0081_pgmap.py | 47 ++++++++++++++++++++++++++---
 1 file changed, 42 insertions(+), 5 deletions(-)

diff --git a/scripts/ss3ds_hooks.d/0081_pgmap.py b/scripts/ss3ds_hooks.d/0081_pgmap.py
index 821e152..dba5632 100644
--- a/scripts/ss3ds_hooks.d/0081_pgmap.py
+++ b/scripts/ss3ds_hooks.d/0081_pgmap.py
@@ -10,20 +10,28 @@ Read-only: existing accessors only, nothing is written to the save. Fails loudly
 import sys
 p = 'src/field/field_control.c'
 s = open(p).read()
-if 'SS3DS 0081' in s:
+if 'SS3DS 0081 r11' in s:
     sys.exit(0)
+if 'SS3DS 0081' in s:  # an older 0081 (before run 11) is staged: take it out, then apply this one
+    import re
+    a = s.index('/* SS3DS 0081 Pokegear'); b = s.index('static void SS3DS_MinimapStep(FieldSystem *fieldSystem, int x, int z) {')
+    s = s[:a] + s[b:]
+    s = re.sub(r'#include "player_data.h" /\* SS3DS 0081 \*/\n(#include "(filesystem|bag|item)\.h"\n)*', '', s)
+    s = s.replace('    SS3DS_PgStep(fieldSystem, mapId); /* SS3DS 0081 */\n', '')
+    if 'SS3DS 0081' in s:
+        sys.exit('0081_pgmap: could not remove the older 0081')
 def sub1(s, old, new):
     if s.count(old) != 1:
         sys.exit('0081_pgmap: anchor not found exactly once: ' + old[:70])
     return s.replace(old, new)
-s = sub1(s, '#include "pm_string.h"\n', '#include "pm_string.h"\n#include "player_data.h" /* SS3DS 0081 */\n#include "filesystem.h"\n')
-helper = r'''/* SS3DS 0081 Pokegear map data for the platform's JOHTO bottom layout (soulsilver3ds/platform/ss3ds_pgmap.h). */
+s = sub1(s, '#include "pm_string.h"\n', '#include "pm_string.h"\n#include "player_data.h" /* SS3DS 0081 */\n#include "filesystem.h"\n#include "bag.h"\n#include "item.h"\n')
+helper = r'''/* SS3DS 0081 Pokegear map data (SS3DS 0081 r11) for the platform's JOHTO bottom layout (soulsilver3ds/platform/ss3ds_pgmap.h). */
 struct SS3DS_PgSpec { u16 mapId; u8 x, y; u16 bits; u8 flavorText, block, u8_, u9, uA, uB, srcX, srcY, dw, dh; };
 extern const struct SS3DS_PgSpec sLocationSpecs[100];
 extern void *P3DS_PgAlloc(int member, u32 size);
 extern volatile int P3DS_PgReady, P3DS_PgLoc;
 extern volatile u32 P3DS_PgTid;
-extern volatile int P3DS_PgShoes;
+extern volatile int P3DS_PgShoes, P3DS_PgGender, P3DS_PgItem;
 extern char P3DS_PgName[100][20];
 extern char P3DS_PgText[100][100];
 
@@ -44,6 +52,15 @@ static int SS3DS_PgAscii(const u16 *c, char *out, int max) {
     return n;
 }
 
+/* copy one NARC member, as stored (LZ-compressed members stay compressed), into a platform buffer under `key` */
+static void SS3DS_PgFetch(int narcId, int mem, int key) {
+    NARC *n = NARC_New(narcId, HEAP_ID_FIELD1);
+    u32 size = NARC_GetMemberSize(n, mem);
+    void *dst = size && size <= 0x10000 ? P3DS_PgAlloc(key, size) : NULL;
+    if (dst) NARC_ReadWholeMember(n, mem, dst);
+    NARC_Delete(n);
+}
+
 static void SS3DS_PgOnce(void) {
     static const int kMembers[3] = { 10, 11, 20 };
     int i;
@@ -67,7 +84,15 @@ static void SS3DS_PgOnce(void) {
         if (dst == NULL) { PSPNativeMemLog("[PGMAP] no room for member %d (%u bytes)", kMembers[i], (unsigned)head[2]); return; }
         ReadFromNarcMemberByIdPair(dst, NARC_application_pokegear_map_pgmap_gra, kMembers[i], 0, head[2]);
     }
-    PSPNativeMemLog("[PGMAP] Pokegear map art and 100 location names read from the ROM");
+    /* run 11: the game's own icons for the JOHTO layout: Pokegear map sprites (palette 0, chars 1, cells 2: player heads),
+       start-menu icons (a/0/1/4: palette 14, chars 18..48 step 3, LZ-compressed as stored). Keys: pgmap member, 100 + a/0/1/4 member. */
+    {
+        int k;
+        for (k = 0; k < 3; k++) SS3DS_PgFetch(NARC_application_pokegear_map_pgmap_gra, k, k);
+        SS3DS_PgFetch(NARC_a_0_1_4, 14, 114);
+        for (k = 0; k < 11; k++) SS3DS_PgFetch(NARC_a_0_1_4, 18 + k * 3, 118 + k * 3);
+    }
+    PSPNativeMemLog("[PGMAP] Pokegear map art, map sprites, start-menu icons and 100 location names read from the ROM");
     P3DS_PgReady = 1;
 }
 
@@ -76,6 +101,18 @@ static void SS3DS_PgStep(FieldSystem *fieldSystem, u32 mapId) {
     s16 wx = 0, wy = 0;
     if (!P3DS_PgReady) SS3DS_PgOnce();
     P3DS_PgTid = PlayerProfile_GetTrainerID(Save_PlayerData_GetProfile(fieldSystem->saveData));
+    {
+        u16 item = Bag_GetRegisteredItem1(Save_Bag_Get(fieldSystem->saveData));
+        P3DS_PgGender = (int)PlayerProfile_GetTrainerGender(Save_PlayerData_GetProfile(fieldSystem->saveData));
+        if ((int)item != P3DS_PgItem) {
+            if (item != 0) {
+                SS3DS_PgFetch(NARC_itemtool_itemdata_item_icon, GetItemIndexMapping(item, ITEMNARC_NCGR), 200);
+                SS3DS_PgFetch(NARC_itemtool_itemdata_item_icon, GetItemIndexMapping(item, ITEMNARC_NCLR), 201);
+            }
+            PSPNativeMemLog("[PGMAP] registered item %d (icon read from the ROM)", (int)item);
+            P3DS_PgItem = (int)item;
+        }
+    }
     P3DS_PgShoes = PlayerSaveData_CheckRunningShoes(PlayerAvatar_GetPlayerSaveData(fieldSystem->playerAvatar)) ? 1 : 0;
     for (i = 0; i < 100 && loc < 0; i++) if (sLocationSpecs[i].mapId == mapId) loc = i;
     if (loc < 0) {
-- 
2.47.3

