From 36e15eb6574cdb547c753605587c971ff6042e7e Mon Sep 17 00:00:00 2001
From: ss3ds <ss3ds@local>
Date: Mon, 26 Oct 2026 05:22:10 +0000
Subject: [PATCH] ss3ds: publish per-location wild species and caught marks for
 the JOHTO map's info card (hook 0084)

---
 scripts/ss3ds_hooks.d/0084_pgspecies.py | 28 +++++++++++++++++++++++++
 scripts/ss3ds_hooks.d/0084_pgspecies.sh |  5 +++++
 2 files changed, 33 insertions(+)
 create mode 100755 scripts/ss3ds_hooks.d/0084_pgspecies.py
 create mode 100755 scripts/ss3ds_hooks.d/0084_pgspecies.sh

diff --git a/scripts/ss3ds_hooks.d/0084_pgspecies.py b/scripts/ss3ds_hooks.d/0084_pgspecies.py
new file mode 100755
index 0000000..b3ce9bb
--- /dev/null
+++ b/scripts/ss3ds_hooks.d/0084_pgspecies.py
@@ -0,0 +1,28 @@
+#!/usr/bin/env python3
+"""ss3ds 0084 wild species list for the JOHTO map's info card, applied after 0083 to src/field/field_control.c.
+Idempotent ('SS3DS 0084' marker). READ-ONLY: publishes the per-location species set that 0083 already builds from the ROM's
+encounter tables (sPsSp) and which of them are caught (Pokedex flags) as two 100x64-byte bitsets (P3DS_PsSp / P3DS_PsCg,
+platform ss3ds_pgmap.h). Nothing is written to the save."""
+import sys
+p = 'src/field/field_control.c'
+s = open(p).read()
+if 'SS3DS 0084' in s:
+    sys.exit(0)
+if 'SS3DS 0083' not in s:
+    sys.exit('0084_pgspecies: hook 0083 is not in field_control.c')
+def sub1(s, old, new):
+    if s.count(old) != 1:
+        sys.exit('0084_pgspecies: anchor not found exactly once: ' + old[:70])
+    return s.replace(old, new)
+s = sub1(s, '#define SS3DS_PS_MAX 2400\n', '#define SS3DS_PS_MAX 2400\nextern u8 P3DS_PsSp[100][64], P3DS_PsCg[100][64]; /* SS3DS 0084 */\n')
+s = sub1(s, '    memcpy(P3DS_PsStat, st, sizeof(st));\n', '''    {   /* SS3DS 0084: species per location + caught bits for the info card's wild list */
+        static u8 cg[100][64];
+        memset(cg, 0, sizeof(cg));
+        for (i = 0; i < 100; i++) for (sp = 1; sp <= 493; sp++) if ((sPsSp[i][sp >> 3] & (1 << (sp & 7))) && Pokedex_CheckMonCaughtFlag(dex, (u16)sp)) cg[i][sp >> 3] |= (u8)(1 << (sp & 7));
+        memcpy(P3DS_PsSp, sPsSp, sizeof(sPsSp));
+        memcpy(P3DS_PsCg, cg, sizeof(cg));
+    }
+    memcpy(P3DS_PsStat, st, sizeof(st));
+''')
+open(p, 'w').write(s)
+print('0084_pgspecies: field_control.c hooked')
diff --git a/scripts/ss3ds_hooks.d/0084_pgspecies.sh b/scripts/ss3ds_hooks.d/0084_pgspecies.sh
new file mode 100755
index 0000000..66524fe
--- /dev/null
+++ b/scripts/ss3ds_hooks.d/0084_pgspecies.sh
@@ -0,0 +1,5 @@
+# ss3ds 0084: wild species list (and caught marks) for the JOHTO map's info card, read-only (after 0083, same object).
+# Not fatal: without it the card says the wild list is not in this build.
+if ! (cd "$C" && python3 "$ROOT/scripts/ss3ds_hooks.d/0084_pgspecies.py" && bash rebuild_game_object.sh src/field/field_control.c field__field_control.o 1); then
+  log "ss3ds 0084 pgspecies hook NOT applied (see message above); the map's info card has no wild list"
+fi
