From de1f22345c899eec9dca238ebcfa9c040cbc5271 Mon Sep 17 00:00:00 2001
From: ss3ds <ss3ds@localhost>
Date: Wed, 28 Oct 2026 04:06:16 +0000
Subject: [PATCH] ss3ds: hook 0120 move type-effectiveness hint snapshot
 (battle_input.c)

Read-only P3DS_MoveHint snapshot (moves, types, power, PP, foe types) taken when the FIGHT menu opens; the port draws the hint panel.
---
 scripts/ss3ds_hooks.d/0120_typehint.py | 46 ++++++++++++++++++++++++++
 scripts/ss3ds_hooks.d/0120_typehint.sh |  4 +++
 2 files changed, 50 insertions(+)
 create mode 100644 scripts/ss3ds_hooks.d/0120_typehint.py
 create mode 100644 scripts/ss3ds_hooks.d/0120_typehint.sh

diff --git a/scripts/ss3ds_hooks.d/0120_typehint.py b/scripts/ss3ds_hooks.d/0120_typehint.py
new file mode 100644
index 0000000..1627b14
--- /dev/null
+++ b/scripts/ss3ds_hooks.d/0120_typehint.py
@@ -0,0 +1,46 @@
+#!/usr/bin/env python3
+"""ss3ds 0120: move type-effectiveness hint (Settings > Battle "Move type hint"). Read-only snapshot P3DS_MoveHint[24],
+published when the FIGHT menu opens (BattleInput_ChangeMenu in battle_input.c); the port draws the x2 / x1/2 / x0 panel
+on the top screen. The game's own UI and logic are untouched. Idempotent ('SS3DS 0120'). Layout:
+ [0] valid (fight menu open)  [1] counter  [2..5] move ids  [6..9] move types  [10..13] move power  [14..15] foe A type1/2
+ [16..17] foe B type1/2 (doubles; 255 = none)  [18..21] PP left"""
+import sys
+p = 'src/battle/battle_input.c'
+s = open(p).read()
+if 'SS3DS 0120' in s:
+    sys.exit(0)
+old = '    battleInput->curMenuId = menuId;\n\n    G2S_SetBlendAlpha('
+if s.count(old) != 1:
+    sys.exit('0120_typehint: anchor not found exactly once in battle_input.c')
+new = ('    battleInput->curMenuId = menuId;\n\n'
+ '    { /* SS3DS 0120 type hint: read-only snapshot for the port (top-screen panel) */\n'
+ '        extern volatile int P3DS_MoveHint[24];\n'
+ '        if (menuId == BATTLE_MENU_FIGHT) {\n'
+ '            BattleInputFightMenu *fm = &battleInput->menu.fight;\n'
+ '            BattleContext *hctx = BattleSystem_GetBattleContext(battleInput->battleSystem);\n'
+ '            int hi;\n'
+ '            for (hi = 0; hi < 4; hi++) {\n'
+ '                u16 mv = fm->moveNo[hi];\n'
+ '                P3DS_MoveHint[2 + hi] = mv;\n'
+ '                P3DS_MoveHint[6 + hi] = mv ? (int)GetMoveAttr(mv, MOVEATTR_TYPE) : 255;\n'
+ '                P3DS_MoveHint[10 + hi] = mv ? (int)GetMoveAttr(mv, MOVEATTR_POWER) : 0;\n'
+ '                P3DS_MoveHint[18 + hi] = fm->pp[hi];\n'
+ '            }\n'
+ '            P3DS_MoveHint[14] = hctx->battleMons[1].hp > 0 ? hctx->battleMons[1].type1 : 255;\n'
+ '            P3DS_MoveHint[15] = hctx->battleMons[1].hp > 0 ? hctx->battleMons[1].type2 : 255;\n'
+ '            if ((BattleSystem_GetBattleType(battleInput->battleSystem) & BATTLE_TYPE_DOUBLES) && hctx->battleMons[3].hp > 0) {\n'
+ '                P3DS_MoveHint[16] = hctx->battleMons[3].type1;\n'
+ '                P3DS_MoveHint[17] = hctx->battleMons[3].type2;\n'
+ '            } else {\n'
+ '                P3DS_MoveHint[16] = 255;\n'
+ '                P3DS_MoveHint[17] = 255;\n'
+ '            }\n'
+ '            P3DS_MoveHint[1] = P3DS_MoveHint[1] + 1;\n'
+ '            P3DS_MoveHint[0] = 1;\n'
+ '        } else {\n'
+ '            P3DS_MoveHint[0] = 0;\n'
+ '        }\n'
+ '    }\n\n'
+ '    G2S_SetBlendAlpha(')
+open(p, 'w').write(s.replace(old, new))
+print('0120_typehint: battle_input.c hooked')
diff --git a/scripts/ss3ds_hooks.d/0120_typehint.sh b/scripts/ss3ds_hooks.d/0120_typehint.sh
new file mode 100644
index 0000000..c6fb97e
--- /dev/null
+++ b/scripts/ss3ds_hooks.d/0120_typehint.sh
@@ -0,0 +1,4 @@
+# ss3ds 0120: move type-effectiveness hint snapshot (battle_input.c, overlay 12). Not fatal: without it the panel never shows.
+if ! (cd "$C" && python3 "$ROOT/scripts/ss3ds_hooks.d/0120_typehint.py" && bash rebuild_game_object.sh src/battle/battle_input.c battle__battle_input.o 12); then
+  log "ss3ds 0120 typehint hook NOT applied (see message above); the move type hint does nothing"
+fi
