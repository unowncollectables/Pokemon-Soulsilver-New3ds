From 7c7fdd87e267954079ec8746a283925043f6dbce Mon Sep 17 00:00:00 2001
From: x <a@b>
Date: Thu, 29 Oct 2026 04:04:59 +0000
Subject: [PATCH] ss3ds: build libntrwifi/libntrdwc with the Linux socket
 backend (online trading M4)

compile-network.py built the network libraries with SDK_PORT and SDK_BUILD_PSP only, so libntrwifi's CPS had no socket backend: CreateSocketEvent, the receive thread, sendto and TcpConnectRaw compiled to nothing. Add -DSDK_BUILD_LINUX so network.c uses its BSD-socket + select thread path (SDL thread/mutex shims already exist in sdl_ctru.c; getifaddrs comes from soulsilver3ds/platform/ss3ds_net.c and toolchain-3ds/pspshim/ifaddrs.h). The other SDK_BUILD_LINUX uses in libntrdwc are header includes only. Only active at run time when wireless=2.
---
 port/native-probe/compile-network.py | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/port/native-probe/compile-network.py b/port/native-probe/compile-network.py
index 59d7187..9e56a04 100644
--- a/port/native-probe/compile-network.py
+++ b/port/native-probe/compile-network.py
@@ -3,7 +3,7 @@ import re,json,subprocess,concurrent.futures
 b=Path(__file__).resolve().parent;out=b/'networkobjects';out.mkdir(exist_ok=True)
 incs=[b.parent/'native-backup-probe/include',b.parent/'native-fonts/include',b.parent/'native-input/include',b.parent/'native-startup/include',b/'backing/include',b.parent/'native-graphics/alias-proof/include',b/'generated',b.parent/'native-graphics/libntr/include',b/'libntrsystem/include',b/'libntrwifi/include',b/'libntrdwc/include',b/'libntrdwc/include/gs',b/'libntrdwc/include/base',b/'libvct/include']
 incs.insert(0,Path('@PSPDEV@/psp/sdk/include'))
-flags=['@PSPDEV@/bin/psp-gcc','-ffile-prefix-map='+str(b.parent)+'=/pspoke/build/tree/test-out/deterministic-path-token-----','-O2','-G0','-ffunction-sections','-fdata-sections','-std=gnu99','-DSDK_PORT','-DSDK_X86','-DSDK_CODE_X86','-DSDK_BUILD_PSP','-DSDK_VERSION_MAJOR=4','-DSDK_TS','-DSDK_4M','-DSDK_FINALROM','-DNNS_FINALROM','-D_NITRO','-DSDK_CW_FORCE_EXPORT_SUPPORT','-DLINK_PPWLOBBY']+['-I'+str(i) for i in incs]
+flags=['@PSPDEV@/bin/psp-gcc','-ffile-prefix-map='+str(b.parent)+'=/pspoke/build/tree/test-out/deterministic-path-token-----','-O2','-G0','-ffunction-sections','-fdata-sections','-std=gnu99','-DSDK_PORT','-DSDK_X86','-DSDK_CODE_X86','-DSDK_BUILD_PSP','-DSDK_BUILD_LINUX','-DSDK_VERSION_MAJOR=4','-DSDK_TS','-DSDK_4M','-DSDK_FINALROM','-DNNS_FINALROM','-D_NITRO','-DSDK_CW_FORCE_EXPORT_SUPPORT','-DLINK_PPWLOBBY']+['-I'+str(i) for i in incs]
 files=[]
 for repo in ['libntrdwc','libntrwifi','libvct']:
  for m in (b/repo).rglob('meson.build'):
-- 
