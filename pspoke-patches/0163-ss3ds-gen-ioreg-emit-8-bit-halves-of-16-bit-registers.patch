From 2de263555229388b64bc23cfe25736360585fd7e Mon Sep 17 00:00:00 2001
From: ss3ds <ss3ds@localhost>
Date: Fri, 30 Oct 2026 03:20:18 -0400
Subject: [PATCH] ss3ds: gen 0163 emit 8-bit halves of 16-bit IO registers in
 gen_ioreg.py

port.py regenerates ds_ioreg.c from this generator on every build, so
the hand edit to ds_ioreg.c in 0160 was wiped before compiling and never
reached any binary (that is why the Transform MOSAIC crash persisted
unchanged). Emit the byte halves here instead: for every plain 16-bit
register, an 8-bit read returns the addressed byte and an 8-bit write
does a read-modify-write of that byte, matching real DS hardware. A half
that already has a native 8-bit case (e.g. the bytes of GX_VRAM_HI_CNT,
which are VRAMCNT_H/I) keeps that case, and FIFO/IPC/card registers keep
aborting, since their accesses have side effects.
---
 .../maploader/gen_ioreg.py                    | 25 +++++++++++++++++++
 1 file changed, 25 insertions(+)

diff --git a/port/soulsilver-native-play/maploader/gen_ioreg.py b/port/soulsilver-native-play/maploader/gen_ioreg.py
index bd15753..3dd5238 100644
--- a/port/soulsilver-native-play/maploader/gen_ioreg.py
+++ b/port/soulsilver-native-play/maploader/gen_ioreg.py
@@ -42,6 +42,11 @@ for (name, width), macro in accessors.items():
     if name in offsets and width in by_width and macro in available:
         by_width[width].setdefault(BASE + offsets[name], macro)
 
+# Byte access to a FIFO, IPC or card register is not a split 16-bit access:
+# those registers have side effects per access, so their halves must keep
+# aborting instead of being silently emulated as plain halves.
+BYTE_HALF_SKIP_ADDRS = {0x04000068, 0x0400006A, 0x04000180, 0x04000184, 0x040001A0, 0x040001A2}
+
 def build(excluded):
   out = ['/* Generated by gen_ioreg.py from the ARM9 SDK register headers. */',
        '#include <nitro.h>', '#include <stdio.h>', '#include <stdlib.h>', '#include <stdint.h>',
@@ -57,6 +62,19 @@ def build(excluded):
         if macro in excluded: continue
         kept[width] += 1
         out.append(f'    case 0x{addr:08x}: return (uint32_t){macro};')
+    if width == 8:
+        # Byte halves of plain 16-bit registers: real DS hardware allows a
+        # byte access to either half (Transform's animation writes OBJ mosaic
+        # this way). A half that already has a native 8-bit case (e.g. the
+        # bytes of GX_VRAM_HI_CNT, which are VRAMCNT_H/I) keeps that case.
+        for addr, macro in sorted(by_width[16].items()):
+            if macro in excluded or addr in BYTE_HALF_SKIP_ADDRS: continue
+            if addr not in by_width[8]:
+                out.append(f'    case 0x{addr:08x}: return (uint32_t)({macro} & 0xFF);')
+                kept[width] += 1
+            if (addr + 1) not in by_width[8]:
+                out.append(f'    case 0x{addr + 1:08x}: return (uint32_t)(({macro} >> 8) & 0xFF);')
+                kept[width] += 1
     out.append('    }')
     out.append(f'    ss_io_bad("{width}-bit read", address); return 0;')
     out.append('}')
@@ -65,6 +83,13 @@ def build(excluded):
     for addr, macro in sorted(by_width[width].items()):
         if macro in excluded: continue
         out.append(f'    case 0x{addr:08x}: {macro} = (uint{width}_t)value; return;')
+    if width == 8:
+        for addr, macro in sorted(by_width[16].items()):
+            if macro in excluded or addr in BYTE_HALF_SKIP_ADDRS: continue
+            if addr not in by_width[8]:
+                out.append(f'    case 0x{addr:08x}: {macro} = (uint16_t)(({macro} & 0xFF00) | (value & 0xFF)); return;')
+            if (addr + 1) not in by_width[8]:
+                out.append(f'    case 0x{addr + 1:08x}: {macro} = (uint16_t)(({macro} & 0x00FF) | ((value & 0xFF) << 8)); return;')
     out.append('    }')
     out.append(f'    ss_io_bad("{width}-bit write", address);')
     out.append('}')
-- 
